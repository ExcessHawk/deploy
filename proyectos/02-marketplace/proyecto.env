# Marketplace multivendedor. Frontend estático, API en contenedor.

NOMBRE="Marketplace multivendedor"
HOST=demo.alfredomejia.com.mx

WEB_REPO=marketplace-front
WEB_ROOT=/var/www/marketplace
WEB_BUILD_ENV=""

# El backend. Aquí viven también sus secretos, que genera bootstrap.sh:
#   .env      usuario y contraseña de Postgres
#   api.env   JWT y webhooks
API_REPO=marketplace-back
API_CONTAINER=marketplace_api
API_PORT=3102
COMPOSE=docker-compose.prod.yml

# Sembrado de la demostración. demo:refresh es lo que corre el cron cada hora.
SEED_CMD="bun run demo:seed"
REFRESH_CMD="bun run demo:refresh"

NGINX_CONF=nginx/marketplace.conf
CRON_FILE=cron/marketplace-demo
