# Copy to deploy/api.env ON THE SERVER and fill it there. Never commit the real one.
# bootstrap.sh generates the secrets for you.

PORT=3102
NODE_ENV=production
LOG_LEVEL=info

# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# openssl rand -base64 36
PAYMENT_WEBHOOK_SECRET=

# Who may call this API from a browser. The portfolio needs to be here or the
# API console in the playground dies on CORS.
CORS_ORIGINS=https://alfredomejia.com.mx,https://www.alfredomejia.com.mx,https://demo.alfredomejia.com.mx

# Behind nginx, so the client IP arrives in X-Forwarded-For with exactly one hop.
# Without this the rate limiter buckets the whole internet under the proxy's IP.
TRUST_PROXY_HOPS=1

RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20

# Las imágenes de producto. El compose monta aquí un volumen con nombre, de
# modo que sobreviven al redespliegue aunque la imagen se reconstruya.
UPLOADS_DIR=/data/uploads

PLATFORM_COMMISSION_BPS=1000
PAYOUT_HOLD_DAYS=0

# Hands out sessions with no password. Only ever true on this box, and only
# because this database holds nothing but invented data.
DEMO_MODE=true

# Not used: the fake payment provider signs its own webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
