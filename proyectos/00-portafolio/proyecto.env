# El portafolio. No tiene backend: es un sitio estático.

NOMBRE="Portafolio"
HOST=alfredomejia.com.mx
ALIAS=www.alfredomejia.com.mx

# Repositorio del frontend y dónde se publica su build.
WEB_REPO=portafolio-v2
WEB_ROOT=/var/www/portafolio

# Variables que necesita su build. El playground apunta al demo del
# marketplace, que se sirve bajo su propio host.
# Una variable por cada demo que el playground embebe. Si falta una, ese
# proyecto queda apuntando a localhost en el sitio publicado, y el iframe sale
# en blanco para todo el mundo menos para ti.
WEB_BUILD_ENV="PUBLIC_SITE_URL=https://alfredomejia.com.mx PUBLIC_DEMO_API=https://demo.alfredomejia.com.mx PUBLIC_DEMO_WEB=https://demo.alfredomejia.com.mx PUBLIC_CITAS_WEB=https://citas.alfredomejia.com.mx PUBLIC_CHAT_WEB=https://chat.alfredomejia.com.mx"

NGINX_CONF=nginx/portafolio.conf
