# Sistema de citas médicas. Frontend estático, API en contenedor.

NOMBRE="Sistema de citas médicas"
HOST=citas.alfredomejia.com.mx

WEB_REPO=citas-front
WEB_ROOT=/var/www/citas
WEB_BUILD_ENV=""

API_REPO=citas-back
API_CONTAINER=citas_api
API_PORT=5000
COMPOSE=docker-compose.prod.yml

SEED_CMD="bun run demo:seed"
REFRESH_CMD="bun run demo:refresh"

NGINX_CONF=nginx/citas.conf
CRON_FILE=cron/citas-demo
