# Plantilla del api.env del sistema de citas. bootstrap.sh la copia al lado del
# backend rellenando solo los campos vacíos, así que los secretos nunca viven
# aquí. DATABASE_URL la pone el compose; no va en este archivo.

PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# Generados por bootstrap.sh con openssl.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=7d

# Quién puede llamar a esta API desde un navegador. El portafolio tiene que
# estar aquí: su consola de playground hace peticiones desde otro dominio, y
# sin esto el navegador las corta antes de que salgan.
CORS_ORIGINS=https://alfredomejia.com.mx,https://www.alfredomejia.com.mx,https://citas.alfredomejia.com.mx

# Detrás de nginx, para que el limitador vea la IP del visitante y no la del
# proxy. Sin esto, todo internet cae en el mismo balde.
TRUST_PROXY_HOPS=1

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Entrega sesiones sin contraseña para los tres roles. Solo se enciende aquí
# porque esta base no tiene datos de personas reales.
DEMO_MODE=true
DEMO_RATE_LIMIT_MAX=40

# Sin credenciales el registro funciona igual, pero nadie recibe aviso.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
