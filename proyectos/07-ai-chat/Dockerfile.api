# El contexto de build es la raíz del repo del backend.
FROM oven/bun:1.4.2-alpine

WORKDIR /app

# Las dependencias primero, en su propia capa: mientras package.json y el
# lockfile no cambien, Docker reutiliza esta capa entre despliegues.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY src ./src
COPY scripts ./scripts
COPY drizzle ./drizzle
COPY drizzle.config.ts tsconfig.json ./

ENV NODE_ENV=production
ENV PORT=3107

USER bun

EXPOSE 3107

CMD ["bun", "run", "src/index.ts"]
