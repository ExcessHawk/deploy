# Copiar a deploy/api.env EN EL SERVIDOR y llenarlo ahí. El real nunca se
# versiona; bootstrap.sh genera los secretos.

PORT=3107
NODE_ENV=production

# Genera cada uno con: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# Quién puede llamar a esta API desde un navegador. El portafolio tiene que
# estar aquí o la consola del playground muere en CORS.
CORS_ORIGINS=https://alfredomejia.com.mx,https://www.alfredomejia.com.mx,https://chat.alfredomejia.com.mx

# Detrás de nginx, el IP del cliente llega en X-Forwarded-For con un salto.
# Sin esto el limitador mete a todo internet en el mismo cubo.
TRUST_PROXY_HOPS=1

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=20
DEMO_RATE_LIMIT_MAX=40

# Tope de gasto por usuario y mes, en centavos de dólar.
USAGE_LIMIT_CENTS=200

# EL CANDADO QUE IMPORTA EN ESTA CAJA.
#
# `echo` inventa la respuesta dentro del proceso y no cuesta nada. Poner
# `anthropic` aquí, con DEMO_MODE encendido, es dejar que cualquier visitante
# gaste dinero de verdad sin límite más que el del periodo.
MODEL_PROVIDER=echo
ANTHROPIC_API_KEY=
ECHO_CHUNK_MS=18

# Entrega sesiones sin contraseña. Solo en esta caja, y solo porque la base no
# tiene más que datos inventados.
DEMO_MODE=true
