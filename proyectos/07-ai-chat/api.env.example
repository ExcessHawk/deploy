# Copiar a deploy/api.env EN EL SERVIDOR y llenarlo ahí. El real nunca se
# versiona; bootstrap.sh genera los secretos.

PORT=3107
NODE_ENV=production

# Genera cada uno con: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# Quién puede llamar a esta API desde un navegador. El portafolio tiene que
# estar aquí o la consola del playground muere en CORS.
CORS_ORIGINS=https://alfredomejia.com.mx,https://www.alfredomejia.com.mx,https://chat.alfredomejia.com.mx

# Detrás de nginx, el IP del cliente llega en X-Forwarded-For con un salto.
# Sin esto el limitador mete a todo internet en el mismo cubo.
TRUST_PROXY_HOPS=1

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=20
DEMO_RATE_LIMIT_MAX=40

# Tope de gasto por usuario y mes, en centavos de dólar.
USAGE_LIMIT_CENTS=200

# Los adjuntos. El compose monta aquí un volumen con nombre, así que
# sobreviven al redespliegue aunque la imagen se reconstruya.
UPLOADS_DIR=/data/uploads
UPLOAD_RATE_LIMIT_MAX=20

# EL CANDADO QUE IMPORTA EN ESTA CAJA.
#
# `echo` inventa la respuesta dentro del proceso y no cuesta nada. Poner aquí
# un proveedor de paga, con DEMO_MODE encendido, es dejar que cualquier
# visitante gaste dinero de verdad. Lo único que lo frena es USAGE_LIMIT_CENTS,
# que es un tope POR CUENTA: como toda la demostración entra con la misma
# cuenta, ese número es el techo de la demostración entera en el mes.
#
# Antes de cambiarlo, revisa que demo:reset NO esté borrando usage_limits. Si
# lo borrara, el cron de cada hora convertiría un tope mensual en uno por hora.
MODEL_PROVIDER=echo
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ECHO_CHUNK_MS=18

# Tope duro de tokens por respuesta. Lo que no se genera no se paga.
GEMINI_MAX_OUTPUT_TOKENS=2048
# Cuánto puede "pensar" el modelo antes de contestar. Vacío deja que lo decida
# él, que es lo más seguro: forzarlo a cero hace que algunos modelos no
# devuelvan nada. Si lo pones, recuerda que ese presupuesto y el de la
# respuesta salen del MISMO maxOutputTokens de arriba.
GEMINI_THINKING_BUDGET=

# Cada cuánto se manda señal de vida mientras el modelo piensa. Un canal que no
# mueve un byte durante diez segundos lo cierra Bun por inactividad, y el 502
# que sale de ahí no se parece en nada a la causa.
STREAM_HEARTBEAT_MS=4000

# Qué modelos ofrecer, en  id:Etiqueta:centavosEntrada:centavosSalida  separados
# por comas. Los centavos son por millón de tokens y alimentan el contador y el
# tope de gasto: si envejecen, el tope miente sin avisar.
#
# Google retira modelos, y cuando lo hace la demostración contesta "This model
# is no longer available" a quien pase por ahí. Para ver qué ofrece tu llave
# hoy, dentro del contenedor:
#
#   docker exec aichat_api bun run models:gemini
#
# Por nombre de contenedor y no con `docker compose exec`: la pila de
# producción se levanta desde el repo de despliegue, no desde la carpeta del
# backend, donde el compose solo define la base de datos.
GEMINI_MODELS="gemini-3.8-flash:Gemini 3.8 Flash:30:250"

# Entrega sesiones sin contraseña. Solo en esta caja, y solo porque la base no
# tiene más que datos inventados.
DEMO_MODE=true
