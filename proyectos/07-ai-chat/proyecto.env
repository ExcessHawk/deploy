# Chat con IA. Frontend estático, API en contenedor.

NOMBRE="Chat con IA (streaming)"
HOST=chat.alfredomejia.com.mx

WEB_REPO=aichat-front
WEB_ROOT=/var/www/aichat
WEB_BUILD_ENV=""

API_REPO=aichat-back
API_CONTAINER=aichat_api
API_PORT=3107
COMPOSE=docker-compose.prod.yml

SEED_CMD="bun run demo:seed"
REFRESH_CMD="bun run demo:refresh"

NGINX_CONF=nginx/aichat.conf
CRON_FILE=cron/aichat-demo

# Esta API no distingue entre vivo y listo, pero /health/ready existe igual.
API_HEALTH=/health/ready
