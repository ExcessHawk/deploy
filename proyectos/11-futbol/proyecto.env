# Fútbol Analytics. No está partido en dos repos: es un dashboard de Streamlit,
# así que todo vive del lado del contenedor y no hay nada estático que publicar.
#
# Sin demostración a propósito. No hay sesiones, no hay cuentas y no hay nada
# que sembrar ni que reiniciar cada hora: quien entra ve los mismos datos que
# cualquier otro, que son resultados de partidos, no datos de personas.

NOMBRE="Fútbol Analytics"
HOST=futbol.alfredomejia.com.mx

# Vacío: no hay frontend que construir.
WEB_REPO=
WEB_ROOT=
WEB_BUILD_ENV=""

API_REPO=futbol-analytics
API_CONTAINER=futbol_app
API_PORT=3108
COMPOSE=docker-compose.prod.yml

# Streamlit trae la suya. Sin esto el script preguntaría por /health, recibiría
# el HTML de la aplicación y se rendiría con el contenedor perfectamente arriba.
API_HEALTH=/_stcore/health

# Este proyecto no es de bun. El esquema lo crea un script de Python, que es
# idempotente: correrlo de nuevo no duplica nada.
MIGRATE_CMD="python scripts/init_db.py"

NGINX_CONF=nginx/futbol.conf
CRON_FILE=cron/futbol-update
