# Plantilla de las variables del contenedor. bootstrap.sh la copia al lado del
# repo como api.env rellenando solo los campos vacíos, así que lo que esté en
# blanco aquí se genera en el servidor y nunca viaja en este repositorio.
#
# Las de la base de datos NO están aquí: las pone docker-compose.prod.yml
# apuntando al servicio postgres de la propia pila.

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# El binario de Tesseract para el analizador de boletos. En la imagen viene de
# apt, así que con el nombre basta.
TESSERACT_CMD=tesseract

# API-Football (api-sports.io). Sin clave, update.py registra que no pudo bajar
# los partidos nuevos de la temporada en curso y sigue con el resto: el
# dashboard no se queda sin datos, solo sin lo más reciente de esa fuente.
#
# El plan Pro de esta cuenta vence el 6 de diciembre de 2026.
APIFOOTBALL_KEY=
